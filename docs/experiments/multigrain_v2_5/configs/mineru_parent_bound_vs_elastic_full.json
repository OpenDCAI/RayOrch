    {"tag": "full_r2_elastic_bs64", "pair": "full_r2_bs64", "rep": 2, "mode": "elastic", "batch_size": 64},
    {"tag": "full_r2_parent_bound_bs64", "pair": "full_r2_bs64", "rep": 2, "mode": "parent_bound", "batch_size": 64},
    {"tag": "full_r3_parent_bound_bs64", "pair": "full_r3_bs64", "rep": 3, "mode": "parent_bound", "batch_size": 64},
    {"tag": "full_r3_elastic_bs64", "pair": "full_r3_bs64", "rep": 3, "mode": "elastic", "batch_size": 64}
  ]
